POSTGRES_DB=finova
POSTGRES_USER=finova
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://finova:replace-with-local-development-password@127.0.0.1:5433/finova
REDIS_URL=redis://localhost:6379/0

# PayPal sandbox credentials; never use live credentials for local development.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Provider-agnostic OpenAI-compatible LLM endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
VISION_MODEL=
AUTH_JWT_SECRET=replace-with-auth-provider-signing-secret
